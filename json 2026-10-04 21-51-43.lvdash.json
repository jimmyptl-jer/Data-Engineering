{
  "datasets": [
    {
      "name": "dataset1",
      "displayName": "json",
      "config": {
        "version": "1.1",
        "source": "`spark-streaming`.jsonstream.json",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "page1",
      "displayName": "New Page",
      "layout": [
        {
          "widget": {
            "name": "bar_chart1",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset1",
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {}
            }
          },
          "position": {
            "x": 3,
            "y": 0,
            "width": 3,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "text_box1",
