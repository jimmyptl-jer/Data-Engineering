# =====================================================================
# Read Kafka Stream using PySpark Structured Streaming
# =====================================================================

def read_kafka_stream():
    """
    Reads Kafka messages as a streaming DataFrame.
    """

    kafka_df = (
        spark.readStream
        .format("kafka")
        .options(**KAFKA_OPTIONS)
        .load()
    )

    messages = (
        kafka_df.select(
            col("timestamp"),
            col("partition"),
            col("offset"),
            col("key").cast("string").alias("key"),
            col("value").cast("string").alias("value"),
        )
    )

    display(messages)

    return messages


# =====================================================================
# Consume Kafka using confluent_kafka
# =====================================================================

def consume():
    """
    Consume messages from Kafka using the Confluent Kafka client.
    """

    consumer = Consumer(consumer_config)
    consumer.subscribe([TOPIC])

    print(f"Listening on topic '{TOPIC}'...")

    try:
        while True:

            msg = consumer.poll(1.0)

            if msg is None:
                continue

            if msg.error():

                if msg.error().code() == KafkaError._PARTITION_EOF:
                    continue

                raise KafkaException(msg.error())

            try:
                value = json.loads(msg.value().decode("utf-8"))

            except (json.JSONDecodeError, UnicodeDecodeError):
                value = msg.value()

            key = (
                msg.key().decode("utf-8")
                if msg.key()
                else None
            )

            print(
                f"partition={msg.partition()} "
                f"offset={msg.offset()} "
                f"key={key} "
                f"value={value}"
            )

    except KeyboardInterrupt:
        print("Stopping consumer...")

    finally:
        consumer.close()


